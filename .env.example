# ==============================================================================
# RANDEVO – Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı .env.local olarak kopyalayın ve kendi bilgilerinizi girin.
# DİKKAT: .env.local dosyası .gitignore'da korumalıdır ve asla Git'e yüklenmez!
# ==============================================================================

# Uygulama Temel Ayarları
NEXT_PUBLIC_APP_NAME="RANDEVO"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="TRY"

# ------------------------------------------------------------------------------
# SUPABASE BAĞLANTI BİLGİLERİ (Supabase Dashboard -> Settings -> API)
# ------------------------------------------------------------------------------
# Projenizin API URL adresi (Örn: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# İstemci (tarayıcı) tarafında güvenle kullanılabilen anon / publishable public key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Yalnızca güvenli sunucu tarafında (Server Actions / API Route) tam yetkili işlemler için:
# DİKKAT: Bu anahtar asla NEXT_PUBLIC_ ile başlamaz ve tarayıcıya iletilmez!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# İsteğe Bağlı Bildirim Entegrasyonları (SMS / E-posta)
RESEND_API_KEY=""
NETGSM_API_KEY=""
NETGSM_USER_CODE=""
