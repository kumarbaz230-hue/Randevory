# ==============================================================================
# RANDEVORY – Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı .env.local olarak kopyalayın ve kendi bilgilerinizi girin.
# DİKKAT: .env.local dosyası .gitignore ile korunmalıdır ve asla repoya commit edilmez!
# ==============================================================================

# Uygulama Temel Ayarları
NEXT_PUBLIC_APP_NAME="RANDEVORY"
NEXT_PUBLIC_APP_SLOGAN="İşini kolaylaştır, zamanını kazan."
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="TRY"

# ------------------------------------------------------------------------------
# SUPABASE BAĞLANTI BİLGİLERİ (Supabase Dashboard -> Settings -> API)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# ÖZEL SMTP & E-POSTA SAĞLAYICISI (Resend veya Brevo)
# Supabase Free Tier'ın saatlik 3-4 e-posta limitini (429 over_email_send_rate_limit)
# kaldırmak ve kurumsal alan adınızdan (örn: noreply@randevory.com) e-posta göndermek için:
# ------------------------------------------------------------------------------
# Resend Entegrasyonu (Önerilen - https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="RANDEVORY <noreply@yourdomain.com>"

# Veya Brevo SMTP (https://brevo.com)
BREVO_SMTP_KEY=""
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER=""

# SMS Bildirim Entegrasyonu (Netgsm - Opsiyonel)
NETGSM_API_KEY=""
NETGSM_USER_CODE=""
